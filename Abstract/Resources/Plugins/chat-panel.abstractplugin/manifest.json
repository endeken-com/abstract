{
  "api": 1,
  "id": "sh.abstract.chat-panel",
  "name": "Chat panel",
  "version": "1.0.0",
  "description": "A sample that sits beside a chat: a side-panel tab naming the chat, a chat menu item, a ⌘K command, a Settings page and a Home card.",
  "entry": "index.html",
  "capabilities": ["chats.read", "storage.own"],
  "contributes": {
    "views": [{ "id": "main", "title": "Chat panel", "symbol": "rectangle.righthalf.inset.filled", "location": "main" }],
    "chatPanelTabs": [{ "id": "chat", "title": "Chat panel", "symbol": "rectangle.righthalf.inset.filled" }],
    "chatMenuItems": [{ "id": "log-chat", "title": "Log This Chat in Chat Panel" }],
    "paletteCommands": [{ "id": "open", "title": "Open Chat Panel" }],
    "settingsPage": { "id": "settings", "title": "Chat Panel Settings" },
    "homeWidgets": [{ "id": "widget", "title": "Chat panel" }]
  }
}
